<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 文件互传 / 局域网同步：release 包必需（debug/profile 模板已带，但 manifest 合并需显式声明） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 隔空互传：WebView 内 getUserMedia 调用摄像头扫描对方屏幕二维码 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 文件互传后台保活：发送过程中保持屏幕/CPU 唤醒，避免息屏中断（#19） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ 通知运行时权限：缺失时系统通知弹窗不出现（提醒/倒计时/番茄钟到点全依赖） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 提醒「闹钟」模式 / 周期提醒：精确闹钟（setAlarmClock）所需。
         Android 12+ 引入 SCHEDULE_EXACT_ALARM：targetSdk ≥ 33 的**新装默认拒绝**，需用户去「闹钟和提醒」手动开；
         所以再声明 USE_EXACT_ALARM（Android 13+，**安装即授予、用户不可撤销**）拿到同样的能力，
         避免真机新装后 setAlarmClock 抛 SecurityException 导致闹钟全废。
         ⚠️ 代价：USE_EXACT_ALARM 受 Google Play 政策限制（仅限闹钟/日历类核心功能），
         本 App 含闹钟/提醒/倒计时/番茄钟，属核心功能，暂按此声明；若将来上 Play 需复核。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- P1-1 应用锁：local_auth 指纹/面容（BiometricPrompt，normal 权限安装即有） -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 路线 2（2026-09-19）：「闹钟送达」写入系统时钟 App（ACTION_SET_ALARM + EXTRA_SKIP_UI 静默写入）。
         厂商时钟是系统应用、任何 ROM 都不会扣它，是真机 ROM 扣第三方到点广播时唯一可靠的闹钟通路 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- 开机重排：awesome_notifications 的 BOOT receiver 靠它收到开机广播后恢复全部通知计划 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 通知振动（Android 13+ 为运行时权限）：提醒/闹钟到点的振动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 闹钟/高优通知锁屏全屏弹出所需（normal 权限）；Android 14+ 还需用户手动授予「全屏通知」 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 到点提醒保活（2026-09-13）：请求「忽略电池优化」。
         有它才能用 ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 一键弹系统对话框（无需跳列表页手动找）。
         关掉电池优化后，系统不再在 Doze 下把本 App 的 AlarmManager 计划延后/丢弃 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 到点提醒保活：常驻前台服务（ReminderKeepAliveService）。
         FOREGROUND_SERVICE 为 Android 9+ 基础权限；Android 14+ 按类型再申一枚 —— 本 App 的守护
         属于「无现成类型可归类」的场景，故用 specialUse（在 <service> 内附 PROPERTY_SPECIAL_USE_FGS_SUBTYPE 说明用途）。
         ⚠️ 不用 dataSync：Android 15 起 dataSync 前台服务有 6 小时/天 上限，到点会被系统 onTimeout 掐掉 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 文件互传接收目录 = 系统 Download/渐离App文件互传/：
         API 30+ 需「所有文件访问」（MANAGE_EXTERNAL_STORAGE，运行时引导授权）；
         API ≤12L 用 WRITE_EXTERNAL_STORAGE + application 的 requestLegacyExternalStorage -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <application
        android:label="渐离App"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- P0-3 系统分享接收：其他 App「分享到渐离」→ 文本/链接进收件抽屉
                 （图片/文件分享 P1 再扩 mimeType；SEND_MULTIPLE 留作将来多选转发） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- P0-4 长按图标静态快捷方式（res/xml/shortcuts.xml：记笔记/扫码/开始专注/习惯打卡，
                 intent 带 quick_action extra → MainActivity 捕获 → Dart takeQuickAction 分发） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 到点提醒保活：常驻前台服务（用户可在「提醒 → 提醒守护」里开关）。
             作用 = 常驻一条低优先级通知把进程留在后台，降低 ROM 省电清理顺手取消 AlarmManager
             计划（提醒到点不响）的概率。exported=false：只由本应用 MainActivity 启动 -->
        <service
            android:name=".ReminderKeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="reminder_delivery_guard" />
        </service>
        <!-- 文件互传「打开所在文件夹」/「用应用打开」：本应用自持 FileProvider，把文件/目录包装为 content:// -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 到点提醒：全屏响铃界面。由 AlarmRingReceiver 发出的**全屏意图通知**拉起（系统负责启动，
             故不受 Android 15「PendingIntent 创建者默认不委托后台启动 Activity 权限」限制），
             息屏/锁屏下前台显示并亮屏；独立于 Flutter，App 被杀也能响铃与交互。
             exported=false：只由本应用通知启动；noHistory 避免留在返回栈 -->
        <activity
            android:name=".AlarmRingActivity"
            android:exported="false"
            android:theme="@style/AlarmFullscreen"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <!-- 到点提醒：闹钟送达（mode=alarm）的接收器。AlarmManager.setAlarmClock 到点触发它，
             它再发一条带全屏意图的高优通知（系统拉起 AlarmRingActivity）并自排下一次。
             exported=false：只由本应用 AlarmScheduler 触发 -->
        <receiver
            android:name=".AlarmRingReceiver"
            android:enabled="true"
            android:exported="false" />
        <!-- 到点提醒：周期「通知」送达（mode=notify）的广播接收器（由原生 AlarmManager.setAlarmClock 触发，
             息屏/App 被杀也能收到广播发通知并自排下次）。exported=false：只由本应用 AlarmScheduler 触发 -->
        <receiver
            android:name=".ReminderAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
        <!-- P0-2 桌面小组件「渐离·今日」：home_widget 桥接。
             数据由 Dart 侧写 SharedPreferences（HomeWidget.saveWidgetData），
             系统更新/解锁/Dart 触发 updateWidget 时由 onUpdate 读快照渲染 RemoteViews。
             exported=false：APPWIDGET_UPDATE 由系统持 BIND_APPWIDGET 权限投递即可达 -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:enabled="true"
            android:exported="false"
            android:label="渐离·今日">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <!-- P0-4 快捷磁贴：下拉控制中心「渐离打卡」→ 点击拉起 App 打卡页。
             exported=true 必须（系统 QuickSettings 需绑定它），由 BIND_QUICK_SETTINGS_TILE 保护 -->
        <service
            android:name=".JianliQuickTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_tile_habit"
            android:label="渐离打卡"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 文件互传「打开」弹层：Android 11+ 包可见性，需声明 VIEW */* 才能 query 到文件管理器/打开应用 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="*/*"/>
        </intent>
    </queries>
</manifest>
