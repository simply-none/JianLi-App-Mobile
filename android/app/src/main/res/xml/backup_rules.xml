<?xml version="1.0" encoding="utf-8"?>
<!-- API < 31 的 Auto Backup 规则：覆盖库文件(file)、设置(sharedpref)、沙盒文件(file)、外部文件(external)，
     确保重装（卸载后重新安装）能从云备份恢复用户数据，所有表都不被擦除。
     db.sqlite 现位于 <filesDir>/databases/db.sqlite（getApplicationSupportDirectory 的返回，即 file 备份域），
     属默认备份根，这里显式包含以防遗漏。 -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
    <include domain="external" path="." />
</full-backup-content>
